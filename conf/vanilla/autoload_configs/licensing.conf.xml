<configuration name="licensing.conf" description="Licensing Configuration">
  <settings>
    <!-- Keygen.sh Account ID -->
    <param name="keygen-account-id" value="7d7d1d22-1603-432a-bc71-b5180c9c81fc"/>

    <!-- Keygen.sh Public Key (Ed25519, used for offline license verification) -->
    <param name="keygen-public-key" value="e8ac8ddab64c456eac366658a465110b205f91a7c6686fe4b1358fe547d26c89"/>
  </settings>

  <key-sources>
    <!-- Relative paths are resolved relative to the SIP Server base directory -->
