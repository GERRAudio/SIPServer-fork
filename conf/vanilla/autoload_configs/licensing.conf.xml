    <!-- Absolute paths are used as-is -->
    <!-- <source type="absolute" value="C:\ProgramData\SIP Server\keys"/> -->
    <!-- <source type="absolute" value="/etc/sipserver/keys"/> -->

    <!-- URL sources will be fetched via HTTP/HTTPS -->
    <!-- <source type="url" value="https://license.example.com/keys"/> -->
  </key-sources>
</configuration>
