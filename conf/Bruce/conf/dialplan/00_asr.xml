<include>

<extension name="asr_hold_queue">
  <condition field="destination_number" expression="^5601$">
    <action application="answer"/>
    <action application="sched_hangup" data="+20 alloc_failure"/>
    <action application="loop_playback" data="C:/inetpub/SIPServer/sounds/custom/asr_please_wait.wav"/>
  </condition>
</extension>

    <extension name="vosk_asr_processing">
      <condition field="destination_number" expression="^5602$">
        <action application="answer"/>
        <action application="sleep" data="50"/>
        <action application="set" data="disable_break=true"/>
        <action application="playback" data="tone_stream://%(150,0,1000)"/>
        <action application="playback" data="C:/inetpub/SIPServer/sounds/custom/asr_ready.wav"/>
        <action application="sleep" data="50"/>
        <action application="play_and_detect_speech" data="silence_stream://5000 detect:vosk default"/>
        <action application="set" data="my_post_body=${detect_speech_result}"/>
        <action application="set" data="disable_break=false"/>
        <action application="set" data="res=${bgapi(curl http://127.0.0.1/api/asr/voicecommand?beltpack=${beltpack_name} content-type application/json post '${my_post_body}')}"/>
        <action application="detect_speech" data="stop"/>
        <action application="playback" data="silence_stream://4000"/>
        <action application="conference" data="asr_holding_room@default+flags{mute|waste|nomoh}"/>
      </condition>
    </extension>
	
	<extension name="asr_announce_only">
		<condition field="destination_number" expression="^5603$">
			<action application="answer"/>
			<action application="sleep" data="50"/>
			<action application="playback" data="silence_stream://20000"/>
		</condition>
	</extension>

</include>