<include>
	<context name="default">

	<!--ASR additions-->
		<!--extension name="asr_active_capture">
			<condition field="destination_number" expression="^5600$">
				<action application="answer"/-->
				
				<!-- crosspoint latch wait -->
				<!--action application="sleep" data="100"/-->
				<!--action application="playback" data="tone_stream://%(250,0,1000)"/>
				
				<action application="set" data="record_sample_rate=16000"/>
				<action application="set" data="record_gain=15"/>
		
				<action application="loop_playback" data="C:/inetpub/SIPServer/sounds/custom/asr_ready.wav"/>
