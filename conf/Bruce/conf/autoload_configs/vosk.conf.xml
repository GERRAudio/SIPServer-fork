<?xml version="1.0" encoding="utf-8"?>
<!--
- ACTIVE PARAMETERS:
    * endpoint-silence-ms : Silence duration (ms) before mod_vosk forces speech result.
    * recognition-words   : Constrained grammar array sent to Vosk server (vosk_recognizer_new_grm).
    * server-url          : Target WebSocket server IP & port.
    * return-json         : Payload formatting flag for FreeSWITCH.
    * auto-reload         : Enables on-the-fly 'reloadxml' updates.

- IGNORED / INFORMATIONAL ONLY:
    * min-confidence        : Ignored by ASR server. Confidence is enforced downstream in IIS .
    * speech-complete-timeout: Ignored by mod_vosk (endpoint-silence-ms is used instead).
    * vad-mode              : Ignored (unsupported by the libvosk C API).

-->
<configuration name="vosk.conf" description="Vosk ASR Configuration">
  <settings>
    <!-- Minimum confidence required (0.0 to 1.0). Speech under this threshold is ignored. -->
    <param name="min-confidence" value="0.75"/> 
    <!-- Voice Activity Detection: controls how strictly silence vs voice is separated. 
         Higher values require clearer, louder speech to trigger an utterance start. -->
    <param name="vad-mode" value="3"/> <!-- Mode 0 (least strict) to 3 (most strict filtering) -->
     <!-- Silence detection timeout in milliseconds -->
    <param name="speech-complete-timeout" value="1000"/>
	
    <param name="server-url" value="ws://127.0.0.1:2700"/>
    <param name="return-json" value="1"/>
    <param name="auto-reload" value="1"/>
    <param name="endpoint-silence-ms" value="1000"/>
