<include>
  <extension name="vosk_asr_queue">
    <condition field="destination_number" expression="^vosk_detect$">
      <action application="answer"/>

      <action application="set" data="play_and_detect_speech_close_asr=true"/>
      <action application="play_and_detect_speech" data="tone_stream://%(200,100,800,1000) detect:vosk default"/>

      <action application="curl" data="http://127.0.0.1/api/asr/voicecommand?beltpack=${beltpack_name} content-type application/json post ${detect_speech_result}"/>

      <action application="park"/>
    </condition>
  </extension>
</include>