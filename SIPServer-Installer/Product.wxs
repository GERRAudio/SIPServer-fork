<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
   xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
   xmlns:lc="http://wixtoolset.org/schemas/v4/wxl"
   xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
   >
  <!-- GERRAudio Distribution 2024-2026 -->

  <?define InstallPathDefault = "C:\inetpub\" ?>
  <?define ReleaseBuildDirectoryPath = "..\..\SIPServer\x64\Release" ?>
  <?define GSTMediaHarvestDir = "..\..\Media" ?>
  <?define VoskASRHarvestDir = "..\..\Vosk" ?>
  <?define IconsEtcHarvestDir= ".\InstallUtils" ?>
  <?define LicenseHarvestDir= "..\..\Licensing" ?>
  <?define CustomSoundsHarvestDir = "..\..\SIPServer\conf\Bruce\custom" ?>
  <?define CustomConfHarvestDir = "..\..\SIPServer\conf\Bruce\conf" ?>

  <Package Name="IP Telephony &#13;&#10;SIPServer v$(var.SIPServerVersion)-msi v$(var.MSIVersion)"
		 Language="1033"
		 Version='$(var.SIPServerVersion)'
		 Manufacturer="GERRAudio Distribution"
		 UpgradeCode="905A0200-CF4C-4FBD-8D36-2A8EA564C8C4"
		 Scope="perMachine"
       >

    <MajorUpgrade  AllowDowngrades="yes"/>
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="OVERWRITE_CONFIGS" Secure="yes" />
    <Property Id="ROOTDRIVE" Value="C:\"/>

    <Feature Id="SIPSERVER" Title="SIP Server" Level="1">
      <ComponentGroupRef Id="HarvestedComponents"/>
      <ComponentGroupRef Id="GSTHarvestedComponents"/>
      <ComponentGroupRef Id="LicensingComponents"/>
      <ComponentGroupRef Id="QueueFolders"/>

      <!-- Sounds Features -->
      <ComponentGroupRef Id="CustomSoundsComponents"/>
      <ComponentGroupRef Id="enSoundsComponents"/>
      <ComponentGroupRef Id="musicSoundsComponents"/>
      <ComponentRef Id="CreateCustomSoundsFolder"/>
      <ComponentRef Id="CreateEnSoundsFolder"/>
      <ComponentRef Id="CreateMusicSoundsFolder"/>

      <ComponentGroupRef Id="VoskASREngine"/>
      <ComponentRef Id="CreateConfFolder"/>

      <!-- Explicit Dialplan Deployment -->
      <ComponentRef Id="ActiveDialplanFiles"/>

      <ComponentGroupRef Id="ConfDefaultsComponents"/>
      <ComponentRef Id="CreateLogFolder"/>
    </Feature>

    <Feature Id="ProductFeature" Title="Main Product" Level="1">
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
    </Feature>

    <!-- VC redistributable install -->
    <DirectoryRef Id="TARGETDIR">
      <Merge Id="VCRedist" SourceFile="C:\Program Files (x86)\Microsoft Visual Studio\2019\BuildTools\VC\Redist\MSVC\14.16.27012\MergeModules\Microsoft_VC141_CRT_x64.msm" DiskId="1" Language="0"/>
    </DirectoryRef>
    <Feature Id="VCRedist" Title="Visual C++ x64 Runtime" AllowAdvertise="no" Display="hidden" Level="1">
      <MergeRef Id="VCRedist"/>
    </Feature>

    <UIRef Id="CustomUI_IP" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Display important setup information" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir_WithIP" InstallDirectory="AppRoot" />

      <Dialog Id="ConfigOptionsDlg" Width="370" Height="270" Title="Configuration Options">
        <Control Id="Title" Type="Text" X="15" Y="15" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="Advanced Configuration" />
        <Control Id="Description" Type="Text" X="25" Y="35" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Select how you want to handle existing configuration files." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="OverwriteConfigsCheckbox" Type="CheckBox" X="25" Y="80" Width="320" Height="17" Property="OVERWRITE_CONFIGS" CheckBoxValue="1" Text="Overwrite existing configuration files?" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="ConfigOptionsDlg" Order="3" Condition="LicenseAccepted = &quot;1&quot;" />
      <Publish Dialog="ConfigOptionsDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="ConfigOptionsDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="ConfigOptionsDlg" Order="3" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchReadme" Condition="(WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1) and NOT Installed"/>
    </UI>

    <Binary Id="readme.txt" SourceFile="$(IconsEtcHarvestDir)\readme.txt" />
    <Property Id="WixShellExecBinaryId" Value="readme.txt" />
    <CustomAction Id="LaunchReadme" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExecBinary" Execute="immediate" Return="ignore" />

    <UIRef Id="WixUI_ErrorProgressText" />
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="[ProductName] installation complete. Please start the SIPServer service (recommended) or run as an app from the start menu." After="FindRelatedProducts" Sequence="ui" />

    <Property Id="AppRoot" Value="$(InstallPathDefault)"/>
    <Property Id="TCPADR" Value="10.8.91.10"/>
    <Property Id="UDPADR" Value="10.8.90.10"/>

    <WixVariable Id="WixUILicenseRtf" Value="$(IconsEtcHarvestDir)\GerrAudiobpl.rtf" />
    <WixVariable Id="WixUIDialogBmp" Value="$(IconsEtcHarvestDir)\GerrAudioDialog.png" />
    <WixVariable Id="WixUIBannerBmp" Value="$(IconsEtcHarvestDir)\GerrAudioBanner.png" />

    <InstallUISequence>
      <Show Dialog="MsiRMFilesInUse" Condition="0" Overridable="yes" Sequence="1" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="MsiRMFilesInUse" Condition="0" Overridable="yes" Sequence="1"  />
    </AdminUISequence>

    <InstallExecuteSequence>
      <Custom Action="StopApp" After="InstallInitialize"  />
      <Custom Action="StopSvc" After="StopApp"  />
      <Custom Action="DeleteSvc" After="StopSvc"  />
      <Custom Action="StopVoskSvc" After="DeleteSvc" />
      <Custom Action="DeleteVoskSvc" After="StopVoskSvc" />
      <Custom Action="Backup" After="DeleteVoskSvc" Condition ='UPGRADINGPRODUCTCODE AND REMOVE~="ALL" AND NOT REINSTALL="ALL"'/>
      <Custom Action="Rename" After="Backup"/>
      <Custom Action="DeployMissingConfigs" Before="SetIP" Condition='NOT REMOVE="ALL"' />
      <Custom Action="SetIP" Before="InstallService" Condition='NOT REMOVE="ALL"' />
      <Custom Action="InstallService" Before="InstallFinalize"   />
      <Custom Action="ConfigSvcSetup" After="InstallService"/>
      <Custom Action="InstallVoskService" Before="InstallFinalize" Condition='NOT REMOVE="ALL"' />
      <Custom Action="SetDirVoskService" After="InstallVoskService" Condition='NOT REMOVE="ALL"' />
      <Custom Action="SetArgsVoskService" After="SetDirVoskService" Condition='NOT REMOVE="ALL"' />
      <Custom Action="SetThrottleVoskService" After="SetArgsVoskService" Condition='NOT REMOVE="ALL"' />
      <Custom Action="SetLogVoskService" After="SetThrottleVoskService" Condition='NOT REMOVE="ALL"' />
      <Custom Action="ConfigVoskSvcSetup" After="SetLogVoskService" Condition='NOT REMOVE="ALL"' />
      <Custom Action="StartVoskSvc" After="ConfigVoskSvcSetup" Condition='NOT REMOVE="ALL"' />
      <Custom Action="LaunchReadme" After ="InstallFinalize" Condition='WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1  and NOT Installed'/>
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <Directory Name="." ComponentGuidGenerationSeed="5950CB39-0D52-4158-A4B1-4BC5AAE9A2C4">
      <Directory Id="AppRoot">
        <Directory Id="MyAppFolder" Name="SIPServer">

          <Directory Id="CONF" Name="conf">
            <Component Id="CreateConfFolder" Guid="A1B2C3D4-E5F6-47A8-9B0C-1D2E3F4A5B6D">
              <CreateFolder />
            </Component>

            <Directory Id="LiveDialplanDir" Name="dialplan">
              <Component Id="ActiveDialplanFiles" Guid="B2C3D4E5-F6A7-4B8C-9D0E-1F2A3B4C5D6E">
                <File Id="Active_00_asr" Source="$(var.CustomConfHarvestDir)\dialplan\00_asr.xml" KeyPath="yes" />
                <File Id="Active_default" Source="$(var.CustomConfHarvestDir)\dialplan\default.xml" />
              </Component>
            </Directory>
          </Directory>

          <Directory Id="CONF_DEFAULTS" Name="conf_defaults" />
          <Directory Id="AutoLoadConf" Name="autoload_configs"/>
          <Directory Id="LOG" Name="log">
            <Component Id="CreateLogFolder" Guid="3DE37BDE-621C-4CCD-A653-C31A5B3B37D8">
              <CreateFolder />
            </Component>
          </Directory>

          <Directory Id="Asr_Queue" Name="asr-queue"/>
          <Directory Id="VoskDir" Name="Vosk"/>

          <Directory Id="Sounds_Dir" Name="sounds">
            <Directory Id="Custom_Sounds_Dir" Name="custom">
              <Component Id="CreateCustomSoundsFolder" Guid="EE876CA1-E5B4-4F68-B42A-A4E31F327E42">
                <CreateFolder />
              </Component>
            </Directory>
            <Directory Id="en_Sounds_Dir" Name="en">
              <Component Id="CreateEnSoundsFolder" Guid="37F0800A-2168-4E85-9CD4-EE1A729419EE">
                <CreateFolder />
              </Component>
            </Directory>
            <Directory Id="Music_Sounds_Dir" Name="music">
              <Component Id="CreateMusicSoundsFolder" Guid="C491083B-7C19-4254-ADF8-C762B3BA8016">
                <CreateFolder />
              </Component>
            </Directory>
          </Directory>
        </Directory>
        <Directory Id="MediaDir" Name="Media"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="MyStartFolder" Name="GerrAudio"/>
      </Directory>
    </Directory>

    <Icon Id="GerrIcon.ico" SourceFile="$(var.IconsEtcHarvestDir)\GerrAudio.ico"/>
    <Icon Id="GerrIconW.ico" SourceFile="$(var.IconsEtcHarvestDir)\GerrAudioW.ico"/>
    <Icon Id="GerrAudioDash.ico" SourceFile="$(var.IconsEtcHarvestDir)\GerrAudioDash.ico"/>

    <ComponentGroup Id="QueueFolders">
      <Component Id="AsrQueueFolder" Guid="D3A7B6B0-1A2B-4C3D-8E9F-0123456789AB" Directory="Asr_Queue">
        <CreateFolder />
        <RemoveFile Id="ClearAsrWavs" Name="*.wav" On="both" />
      </Component>
    </ComponentGroup>

    <!-- Corrected Harvest Syntax for Sounds -->
    <ComponentGroup Id="CustomSoundsComponents" Directory="Custom_Sounds_Dir">
      <Files Include="$(var.CustomSoundsHarvestDir)\**\*" />
    </ComponentGroup>

    <ComponentGroup Id="enSoundsComponents" Directory="en_Sounds_Dir">
      <Files Include="$(var.ReleaseBuildDirectoryPath)\sounds\en\**\*" />
    </ComponentGroup>

    <ComponentGroup Id="musicSoundsComponents" Directory="Music_Sounds_Dir">
      <Files Include="$(var.ReleaseBuildDirectoryPath)\sounds\music\**\*" />
    </ComponentGroup>

    <ComponentGroup Id="VoskASREngine" Directory="VoskDir">
      <Files Include="$(var.VoskASRHarvestDir)\**\*" />
    </ComponentGroup>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="ApplicationShortcutDesktop" Guid="335335B2-F691-408E-A857-56C3D30DA636">
        <Shortcut Id="ServiceStartDesktopShortcut" Name="Start SIPServer Service" Description="SIPServer Service Start" Target="[MyAppFolder]SvcStart.bat" WorkingDirectory="MyAppFolder" Icon="GerrIconW.ico" />
        <Shortcut Id="ServiceStopDesktopShortcut" Name="Stop SIPServer Service" Description="SIPServer Service Stop" Target="[MyAppFolder]SvcStop.bat" WorkingDirectory="MyAppFolder" Icon="GerrIcon.ico" />
        <Shortcut Id="CLIApplicationDesktopShortcut" Name="Command Line Interface (CLI)" Description="SIPServer Command Line Interface (CLI)" Target="[MyAppFolder]EngineCommandLine.exe" WorkingDirectory="MyAppFolder" Icon="GerrIconW.ico"/>
        <Shortcut Id="ServiceQueryDesktopShortcut" Name="Service Status" Description="SIPServer Service Query Status" Target="[MyAppFolder]SvcQuery.bat" WorkingDirectory="MyAppFolder" Icon="GerrIcon.ico"/>

        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPServerIDT" Name="installed1" Type="integer" Value="1" KeyPath="yes"/>
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPServerDT" Name="installed1" Type="string" Value="SIPServer"  />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\fs_cliIDT" Name="installed2" Type="integer" Value="1" />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\fs_cliDT" Name="installed2" Type="string" Value="SIPServer-CLI"  />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStartIDT" Name="installed3" Type="integer" Value="1" />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStartDT" Name="installed3" Type="string" Value="ServerSvcStart"  />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStopIDT" Name="installed4" Type="integer" Value="1" />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStopDT" Name="installed4" Type="string" Value="ServerSvcStop"  />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="MyStartFolder">
      <Component Id="ApplicationShortcut" Guid="F5E4852D-0A23-4BBF-8E43-99B9D9C80837">
        <Shortcut Id="ServiceStartMenuShortcut" Name="1 - Start SIP Service" Description="Start the SIPServer service" Target="[MyAppFolder]SvcStart.bat" WorkingDirectory="MyAppFolder" Icon="GerrIconW.ico" />
        <Shortcut Id="ServiceStopMenuShortcut" Name="2 - Stop SIP Service" Description="Stop the SIPServer service" Target="[MyAppFolder]SvcStop.bat" WorkingDirectory="MyAppFolder" Icon="GerrIcon.ico" />
        <Shortcut Id="CLIApplicationStartMenuShortcut" Name="3 - Command Line Interface (CLI)" Description="Command Line Interface (CLI) to access the service" Target="[MyAppFolder]EngineCommandLine.exe" WorkingDirectory="MyAppFolder" Icon="GerrIconW.ico"/>
        <Shortcut Id="ServiceQueryStartMenuShortcut" Name="4 - Service Status" Description="SIPServer Service Query Status" Target="[MyAppFolder]SvcQuery.bat" WorkingDirectory="MyAppFolder" Icon="GerrIcon.ico"/>
        <Shortcut Id="ApplicationStartMenuShortcut" Name="5 - SIPServer Console" Description="SIPServer Console" Target="[MyAppFolder]SIPServer.exe" WorkingDirectory="MyAppFolder" Icon="GerrIcon.ico"/>

        <RemoveFolder Id="UninstallShortcut" Directory="MyStartFolder" On="uninstall"/>

        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStartI" Name="installed3" Type="integer" Value="1" />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStart" Name="installed3" Type="string" Value="ServerSvcStart"  />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStopI" Name="installed4" Type="integer" Value="1" />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPSvcStop" Name="installed4" Type="string" Value="ServerSvcStop"  />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\fs_cliI" Name="installed2" Type="integer" Value="1" />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\fs_cli" Name="installed2" Type="string" Value="SIPServer-CLI"  />
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPServerI" Name="installed1" Type="integer" Value="1" KeyPath="yes"/>
        <RegistryValue Root="HKCU" Key="Software\GerrAudio\SIPServer" Name="installed1" Type="string" Value="SIPServer"  />
      </Component>
    </DirectoryRef>

    <ComponentGroup Id="LicensingComponents" Directory="AutoLoadConf">
      <Component Id="LicensingConfig" Guid="BC640D04-085D-48CD-8A70-1BA04442A9D6" Directory="AutoLoadConf" NeverOverwrite="yes" Permanent="yes">
        <File Id="LicensingConfigFile" Source="$(var.LicenseHarvestDir)\licensing.conf.xml" KeyPath="yes"/>
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ConfDefaultsComponents" Directory="CONF_DEFAULTS">
      <Files Include="$(var.CustomConfHarvestDir)\**" />
    </ComponentGroup>

    <ComponentGroup  Id="HarvestedComponents" Directory="MyAppFolder">
      <Component Id="VCRuntime" Guid="E194CCDE-5D35-4284-AAC2-552A81C663E5">
        <File Id="VCRuntime" Source="$(var.IconsEtcHarvestDir)\VCRUNTIME140.dll" KeyPath="yes" />
      </Component>
      <Component Id="VCRuntime1" Guid="88291E6E-2281-4F5C-805D-67A6644B5A83">
        <File Id="VCRuntime1" Source="$(var.IconsEtcHarvestDir)\VCRUNTIME140_1.dll" KeyPath="yes" />
      </Component>
      <Component Id="RenBackupFile" Guid="4BFDE8BB-EF40-4755-AF9C-18221D1D3DC4">
        <File Id="RenBackupScript" Source="$(var.IconsEtcHarvestDir)\RenBackup.bat" KeyPath="yes" />
      </Component>
      <Component Id="SvcQuery" Guid="A5D8FF09-DB6F-4AC2-B3FA-18E588128018">
        <File Id="SvcQueryScript" Source="$(var.IconsEtcHarvestDir)\SvcQuery.bat" KeyPath="yes" />
      </Component>
      <Component Id="SvcStart" Guid="45342FAC-4BA4-49E4-BA31-74BE1ACE4BDC">
        <File Id="SvcStartScript" Source="$(var.IconsEtcHarvestDir)\SvcStart.bat" KeyPath="yes" />
      </Component>
      <Component Id="SvcStop" Guid="D51BA800-BFB9-44BB-AF34-946F0BF7A5C8">
        <File Id="SvcStopScript" Source="$(var.IconsEtcHarvestDir)\SvcStop.bat" KeyPath="yes" />
      </Component>
      <Component Id="SetIP" Guid="5E8F3974-81B1-4984-BBCA-A42FE2D252C9">
        <File Id="SetIPScript" Source="$(var.IconsEtcHarvestDir)\SetIP.bat" KeyPath="yes" />
      </Component>
      <Component Id="grep" Guid="4A04A90C-094C-466B-86CB-2C3E2DBCE7B0">
        <File Id="grep" Source="$(var.IconsEtcHarvestDir)\grep.exe" KeyPath="yes" />
      </Component>
      <Component Id="svcinstaller" Guid="FFE671AF-0508-41DF-9500-194F3EDDD401">
        <File Id="nssm" Source="$(var.IconsEtcHarvestDir)\nssm.exe" KeyPath="yes" />
      </Component>
      <Component Id="readme.txt" Guid="2A142FE7-4D4D-43F8-AD24-A8144543933B">
        <File Id="readme.txt" Source="$(var.IconsEtcHarvestDir)\readme.txt" KeyPath="yes" />
      </Component>

      <Files Include="$(var.ReleaseBuildDirectoryPath)\**">
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\conf\**" />
        <Exclude Files="$(var.ReleaseBuildDirectoryPath)\sounds\**" />
        <Exclude Files="$(var.CustomSoundsHarvestDir)\**"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\ASRSideCar.csx"/>
        <Exclude Files="$(var.ReleaseBuildDirectoryPath)\Product Keys\status.html"/>
        <Exclude Files="$(var.ReleaseBuildDirectoryPath)\Product Keys\*.lic"/>
        <Exclude Files="$(var.ReleaseBuildDirectoryPath)\Product Keys\license.machine-id"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\VCRUNTIME140.dll"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\VCRUNTIME140_1.dll"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.remove"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\RenBackup.bat"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\SvcQuery.bat"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\SvcStop.bat"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\SvcStart.bat"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\SetIP.bat"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\grep.exe"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\nssm.exe"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\readme.txt"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\.git*"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\.git"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\.gitignore"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\.pem"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.ipdb"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.bsc"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.ilk"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.pdb"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.lib"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.exp"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.log"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.user"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.suo"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.ncb"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.map"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.obj"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.idb"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.res"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.cab"/>
        <Exclude Files ="$(var.ReleaseBuildDirectoryPath)\**\*.msi"/>
      </Files>
    </ComponentGroup>

    <ComponentGroup  Id="GSTHarvestedComponents" Directory="MediaDir">
      <Files Include="$(var.GSTMediaHarvestDir)\**">
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\.git*"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\.git"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\.pem"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\.gitignore"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.ipdb"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.bsc"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.ilk"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.pdb"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.lib"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.exp"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.log"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.user"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.suo"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.ncb"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.map"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.obj"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.idb"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.res"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.cab"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.msi"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.h"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.c"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.cpp"/>
        <Exclude Files ="$(var.GSTMediaHarvestDir)\**\*.props"/>
      </Files>
    </ComponentGroup>

    <CustomAction Id="StopApp" ExeCommand='cmd.exe /c  echo Stopping SIPServer... please do not close window &amp;&amp; [MyAppFolder]\SIPServer.exe -stop 2>NUL >NUL &amp;&amp; taskkill /F /IM gst-ptp-helper.exe 2>NUL >NUL' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="StopSvc" ExeCommand='cmd.exe /c echo Stopping service... please do not close window &amp;&amp; sc stop SIPServer 2>NUL >NUL &amp;&amp; sc stop "SIP Server" 2>NUL >NUL' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="DeleteSvc" ExeCommand='cmd.exe /c echo Uninstalling service... please do not close window &amp;&amp; sc delete SIPServer 2>NUL >NUL  sc delete "SIP Server" 2>NUL >NUL' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />

    <CustomAction Id="StopVoskSvc" ExeCommand='cmd.exe /c echo Stopping ASR service... please do not close window &amp;&amp; sc stop VoskASR 2>NUL >NUL &amp;' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="DeleteVoskSvc" ExeCommand='cmd.exe /c echo Uninstalling service... please do not close window &amp;&amp; sc delete VoskASR 2>' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />

    <CustomAction Id="Backup" ExeCommand='cmd.exe /c echo Backing up... please do not close window. This may take some time depending on the size of the log files. &amp;&amp; XCOPY [MyAppFolder] [AppRoot]\SIPServerTemp /Y/C/H/E/J/K/O/Q/I >NUL 2>NUL' Directory="AppRoot" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="Rename" ExeCommand='cmd.exe /c [MyAppFolder]\RenBackup.bat [AppRoot] ' Directory="AppRoot" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="SetIP" ExeCommand='cmd.exe /c [MyAppFolder]\SetIP.bat [TCPADR] [UDPADR] [MyAppFolder]' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />

    <CustomAction Id="InstallService" ExeCommand='[MyAppFolder]\nssm install SIPServer "[MyAppFolder]\SIPServer.exe"' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="ConfigSvcSetup" ExeCommand='cmd.exe /c echo Configuring service... please do not close window &amp;&amp; sc failure SIPServer reset=259100 actions=restart/10000 2>NUL >NUL' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />

    <CustomAction Id="InstallVoskService" ExeCommand='[MyAppFolder]nssm.exe install VoskASR "[MyAppFolder]Vosk\Vosk_server.exe"' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="SetDirVoskService" ExeCommand='[MyAppFolder]nssm.exe set VoskASR AppDirectory "[MyAppFolder]Vosk"' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="SetArgsVoskService" ExeCommand='[MyAppFolder]nssm.exe set VoskASR AppParameters "[VoskDir]models\vosk-model-small-en-us-0.15 2700"' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="SetThrottleVoskService" ExeCommand='[MyAppFolder]nssm.exe set VoskASR AppThrottle 10000' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="SetLogVoskService" ExeCommand='cmd.exe /c "[MyAppFolder]nssm.exe" set VoskASR AppStdout "[MyAppFolder]Vosk\vosk_server.log" &amp;&amp; "[MyAppFolder]nssm.exe" set VoskASR AppStderr "[MyAppFolder]Vosk\vosk_server.log" &amp;&amp; "[MyAppFolder]nssm.exe" set VoskASR AppRotateFiles 1 &amp;&amp; "[MyAppFolder]nssm.exe" set VoskASR AppRotateBytes 5242880' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="ConfigVoskSvcSetup" ExeCommand='cmd.exe /c echo Configuring service... please do not close window &amp;&amp; sc failure VoskASR reset=259100 actions=restart/10000 2>NUL >NUL' Directory="MyAppFolder" Execute="deferred" Return="ignore" Impersonate="no" />
    <CustomAction Id="StartVoskSvc" ExeCommand='cmd.exe /c echo Starting ASR service... please do not close window &amp;&amp; sc start VoskASR 2>NUL >NUL' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
    <CustomAction Id="DeployMissingConfigs" ExeCommand='cmd.exe /c robocopy "[MyAppFolder]conf_defaults" "[MyAppFolder]conf" /E /XC /XN /XO 2&gt;NUL &gt;NUL' Directory="MyAppFolder" Execute="deferred" Impersonate="no" Return="ignore" />
  </Fragment>
</Wix>